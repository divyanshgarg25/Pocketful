# Pocketful Environment Configuration Template

# Server & Runtime
PORT=3001
NODE_ENV=development
APP_BASE_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173
DEFAULT_CURRENCY=USD
DEMO_MODE=false

# Granular Simulation and Demo Flags (forced to false in production)
# PAYPAL_SIMULATE: enables PayPal sandbox mock execution without network calls in dev/test
PAYPAL_SIMULATE=true
# GEMINI_SIMULATE: enables pre-computed golden response cache in dev/test
GEMINI_SIMULATE=true
# PLACES_LIVE: enables live Nominatim and Overpass API queries instead of local fallback
PLACES_LIVE=false
# AUTH_ALLOW_DEMO: allows signed dev login in non-production environments
AUTH_ALLOW_DEMO=true

# Step-up verification (passkeys / authenticator app / PIN)
# STEP_UP_ENC_KEY: 64 hex chars (32 bytes) sealing TOTP secrets at rest. REQUIRED in production
# (generate: openssl rand -hex 32). Unset in development = random per process (enrolled authenticators reset on restart).
# STEP_UP_ENC_KEY=
# WEBAUTHN_RP_ID / WEBAUTHN_ORIGINS default to the host/origin of APP_BASE_URL. Override only deliberately.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=Pocketful
# WEBAUTHN_ORIGINS=http://localhost:5173
# STEP_UP_TEST_MODE: software test authenticator for tests/e2e. The API refuses to boot in production if this is true.
STEP_UP_TEST_MODE=false
# STEP_UP_TEST_SECRET=

# Web demo UI (frontend build flag): 1-click demo sign-in + prefilled demo identity.
# On for `vite dev`; OFF in production builds unless this is set to true on purpose.
# VITE_ENABLE_DEMO=false

# Supabase (Postgres & Auth)
SUPABASE_URL=https://demo.supabase.co
SUPABASE_ANON_KEY=demo-anon-key
SUPABASE_SERVICE_ROLE_KEY=demo-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Google Gemini AI
GEMINI_API_KEY=demo-gemini-key
GEMINI_MODEL=gemini-2.5-flash

# PayPal Sandbox REST APIs
PAYPAL_CLIENT_ID=demo-paypal-client-id
PAYPAL_CLIENT_SECRET=demo-paypal-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=demo-webhook-id
# The PayPal account that RECEIVES friends' payments (Pocketful's own merchant account; there is no organizer payout).
# Named on every order and checked on capture. REQUIRED in production: set a merchant id (13 chars) or, instead, an email.
# PAYPAL_PAYEE_MERCHANT_ID=
# PAYPAL_PAYEE_EMAIL=

# Geocoding & OpenStreetMap
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_UA=pocketful-hackathon (divyanshgarg2504@gmail.com)

# Step-up hardening
# Hours a newly enrolled/replaced/reset step-up factor cannot approve money actions. Default 24 in production
# (and must be >= 1 there), 0 everywhere else.
# STEPUP_ENROLL_COOLDOWN_HOURS=0
# Number of reverse proxies in front of the API (Render = 1; local dev has none). Integer 0-10.
TRUST_PROXY_HOPS=1
# NODE_ENV must be set explicitly on any public host (the API refuses to boot if it is unset and APP_BASE_URL is not local).
