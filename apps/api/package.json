{
    "name": "pocketful-api",
    "version": "1.0.0",
    "private": true,
    "description": "Express REST API and Autonomous Agent Layer for Pocketful",
    "type": "module",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:db:run": "vitest run --config vitest.db.config.ts"
    },
    "dependencies": {
        "@simplewebauthn/server": "^14.1.0",
        "@supabase/supabase-js": "^2.45.4",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.0",
        "express-rate-limit": "^8.7.3",
        "fuse.js": "^7.0.0",
        "helmet": "^8.3.0",
        "jose": "^6.2.15",
        "jstat": "^1.9.6",
        "node-cron": "^4.6.0",
        "zod": "^4.6.7"
    },
    "overrides": {
        "uuid": "^11.1.1"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^22.10.0",
        "@types/node-cron": "^3.0.11",
        "@types/pg": "^8.23.1",
        "pg": "^8.23.1",
        "tsx": "^4.19.1",
        "typescript": "^5.5.4",
        "vitest": "^5.1.0"
    }
}
